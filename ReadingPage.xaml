<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookNest.ReadingPage"
             Title="Reading diary">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">

            <!-- Додати сесію читання -->
            <Label Text="New reading session" FontSize="18" FontAttributes="Bold" />
            <Entry x:Name="bookEntry" Placeholder="Book title" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry x:Name="minutesEntry" Placeholder="Minutes" Keyboard="Numeric" />
                <Entry x:Name="pagesEntry" Grid.Column="1" Placeholder="Pages (optional)" Keyboard="Numeric" />
            </Grid>
            <Entry x:Name="noteEntry" Placeholder="Note (optional)" />
            <Button Text="Add session" Clicked="OnAdd" />
            <Label x:Name="errorLabel" TextColor="Red" IsVisible="False" />

            <!-- Статистика -->
            <Label Text="Statistics" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="totalLabel" />
            <Label x:Name="favouriteLabel" />
            <Label x:Name="goalLabel" />
            <ProgressBar x:Name="goalBar" ProgressColor="#4F46E5" />

            <!-- Графік за 7 днів (стовпчики малюємо в коді) -->
            <Label Text="Last 7 days (minutes)" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Grid x:Name="chart" HeightRequest="150" ColumnSpacing="6" />

            <!-- Історія -->
            <Label Text="History" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="emptyLabel" Text="No sessions yet." TextColor="Gray" />
            <VerticalStackLayout x:Name="historyList" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Details}" TextColor="#4F46E5" />
                                <Label Text="{Binding When}" TextColor="Gray" FontSize="13" />
                                <Label Text="{Binding Note}" FontSize="14" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Delete" Clicked="OnDelete" FontSize="13"
                                    VerticalOptions="Start" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
