<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookNest.DetailPage"
             Title="Book">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Grid ColumnDefinitions="110,*" ColumnSpacing="14">
                <Image x:Name="coverImage" WidthRequest="110" HeightRequest="160" Aspect="AspectFill" VerticalOptions="Start" />
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label x:Name="titleLabel" FontSize="22" FontAttributes="Bold" />
                    <Label x:Name="authorLabel" FontSize="16" />
                    <Label x:Name="infoLabel" TextColor="Gray" />
                </VerticalStackLayout>
            </Grid>

            <Button x:Name="starButton" Clicked="OnStar" />

            <Label Text="About" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label x:Name="descriptionLabel" Text="Loading..." />

            <Label x:Name="subjectsLabel" TextColor="Gray" FontSize="13" />

            <Label x:Name="othersTitle" Text="More by this author" FontSize="18" FontAttributes="Bold" Margin="0,8,0,0" />
            <Label x:Name="othersMessage" Text="Loading..." TextColor="Gray" />

            <!-- Список інших книжок автора -->
            <VerticalStackLayout x:Name="othersList" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Year}" TextColor="Gray" FontSize="13" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
