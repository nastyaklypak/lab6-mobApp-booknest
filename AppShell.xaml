<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:BookNest"
       x:Class="BookNest.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="#4F46E5"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarTitleColor="#4F46E5">

    <!-- Нижнє меню з чотирма сторінками -->
    <TabBar>
        <ShellContent Title="Search" ContentTemplate="{DataTemplate local:SearchPage}" />
        <ShellContent Title="Favorites" ContentTemplate="{DataTemplate local:FavoritesPage}" />
        <ShellContent Title="Reading" ContentTemplate="{DataTemplate local:ReadingPage}" />
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate local:SettingsPage}" />
    </TabBar>

</Shell>
